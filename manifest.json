{
  "manifest_version": 3,
  "name": "Point2Prompt",
  "version": "1.0",
  "permissions": ["scripting", "activeTab"],
  "action": {
     "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "Select to Prompt (Alt+Shift+S)"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Activate Claude Selector"
    }

  }
}


